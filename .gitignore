#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Scraped wiki content — regenerate with tools/scraper (see README).
# Not committed: it is Fextralife's content, and it is ~80 MB.
/assets/data/
/assets/img/

# Scraper scratch space
tools/scraper/venv/
tools/scraper/html_cache/
tools/scraper/images_raw/
tools/scraper/images_opt/
tools/scraper/parsed/
tools/scraper/*.html
tools/scraper/*.xml
tools/scraper/*.txt

# Icon build products (regenerate with icon/make_icons.py); the 1024 master is
# kept because the README shows it.
icon/preview*.png
icon/mask_preview.png
icon/icon_foreground.svg
icon/icon_background.svg
